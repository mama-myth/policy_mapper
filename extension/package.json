{
  "name": "policy-to-code-mapper",
  "displayName": "Policy-to-Code Mapper",
  "description": "A Context-Aware IDE Assistant for Real-Time Security and Policy Guidance",
  "version": "0.1.0",
  "publisher": "policy-to-code",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "policyToCode.analyzeFile",
        "title": "Policy-to-Code: Analyze Current File"
      },
      {
        "command": "policyToCode.viewTraceability",
        "title": "Policy-to-Code: View Traceability"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
